{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "issued_at",
    "expires_at",
    "addons"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "addons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "version",
          "download_url",
          "sha256",
          "license",
          "cms_compatibility",
          "php_compatibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "download_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string"
          },
          "cms_compatibility": {
            "type": "object",
            "required": [
              "major",
              "minimum"
            ],
            "properties": {
              "major": {
                "const": 10
              },
              "minimum": {
                "type": "string"
              }
            }
          },
          "php_compatibility": {
            "type": "object",
            "required": [
              "minimum"
            ],
            "properties": {
              "minimum": {
                "type": "string"
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "issued_at": {
      "type": "integer",
      "minimum": 1
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    }
  }
}
