{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComposrCMS Extended signed source registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "sequence",
    "issued_at",
    "expires_at",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_id": {
      "const": "composrcms-v10-extended"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0
    },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "manifest_url",
          "enabled",
          "signing_key_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "manifest_url": {
            "type": "string",
            "format": "uri"
          },
          "enabled": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer"
          },
          "trust_level": {
            "type": "string"
          },
          "signing_key_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
